<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\StorageFinder.ico</ApplicationIcon>
    <AssemblyName>StorageFinder</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\StorageFinder.Core\StorageFinder.Core.csproj" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2045.28" />
    <Content Include="Web\**\*" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="Assets\StorageFinder.png;Assets\StorageFinder.ico;Assets\StorageFinder.svg" Link="Web\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <EmbeddedResource Include="Assets\StorageFinder.ico" />
  </ItemGroup>
</Project>
